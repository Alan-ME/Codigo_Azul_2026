# ==============================================================================
# CONFIGURACIÓN LOCAL SIN RIESGO
# ==============================================================================
# (Estas variables pueden ser definidas libremente por cualquier desarrollador)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# INFRAESTRUCTURA COMPARTIDA DEL EQUIPO
# ==============================================================================
# (Solicitar los valores reales al administrador de la infraestructura, ej. Ivan Cardozo. ¡NO INVENTAR!)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codigo_azul_db
DB_USER=postgres
DB_PASSWORD=secret_password_example
JWT_SECRET=super_secret_jwt_key_example
JWT_EXPIRES_IN=24h

# ==============================================================================
# VARIABLES DE MI ROL (Push Notifications & Telemetry)
# ==============================================================================
# (Obtener desde la Consola de Firebase del proyecto -> Configuración -> Cuentas de Servicio)
FCM_PROJECT_ID=mi-proyecto-firebase-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto-firebase-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"
