@startuml UML_02_Diagrama_de_Secuencia
!theme plain
skinparam sequenceMessageAlign center
skinparam roundcorner 6
skinparam shadowing true
skinparam backgroundColor #FFFFFF
skinparam sequence {
    ParticipantBackgroundColor #1E293B
    ParticipantBorderColor #0F172A
    ParticipantFontColor #FFFFFF
    ActorBackgroundColor #0284C7
    ActorBorderColor #0369A1
    ActorFontColor #0F172A
    LifeLineBackgroundColor #94A3B8
    LifeLineBorderColor #475569
    BoxBackgroundColor #F8FAFC
    BoxBorderColor #CBD5E1
}

header Plataforma Hospitalaria Código Azul — ONETP 2026
title UML-02: Diagrama de Secuencia — Cascada Transaccional & Reactiva

actor "Médico Activador\n(PWA / Móvil)" as Activador
box "Backend Core (Express 5 / Node.js 24)" #EFF6FF
    participant "API REST\n(Express Router)" as API
    participant "Use Cases\n(Clean Architecture)" as UseCase
    participant "appEvents\n(Event Bus)" as EventBus
    participant "Socket Gateway\n(Socket.IO)" as Sockets
end box

box "Infraestructura & Persistencia" #FEF3C7
    database "PostgreSQL 18\n(ACID Engine)" as DB
    participant "Firebase Cloud\n(FCM HTTP v1)" as FCM
end box

actor "Dashboard Guardia\n(Web React)" as Guardia
actor "Reanimador Médico\n(Terminal Móvil)" as Reanimador

== 1. Activación de Código Azul y Barrera de Idempotencia ==

Activador -> API: POST /api/v1/incidentes/activar\n[Bearer JWT, { ubicacionId: 4 }]
activate API

API -> API: authenticateJWT() + requireRole('MEDICO_ACTIVADOR')
API -> UseCase: ActivarCodigoAzulUseCase.execute({ ubicacionId, user })
activate UseCase

UseCase -> DB: findRecentActiveByUbicacion(ubicacionId, 60s)
activate DB
DB --> UseCase: resultadoQuery
deactivate DB

alt Incidente Activo Existente (< 60s en la misma sala)
    UseCase -> DB: INSERT auditoria ('ACTIVACION_REDUNDANTE_BLOQUEADA')
    UseCase --> API: { incidenteExistente, esReincidencia: true }
    API --> Activador: HTTP 200 OK (UUID existente, no duplica)
else Nueva Alerta de Emergencia
    UseCase -> DB: BEGIN TRANSACTION
    activate DB
    UseCase -> DB: INSERT INTO incidentes (estado='ACTIVADO', ubicacion_id, activador_id)\nRETURNING id, codigo_uuid, created_at
    UseCase -> DB: INSERT INTO incidentes_auditoria_eventos\n(tipo='ACTIVACION', payload_data JSONB)
    UseCase -> DB: COMMIT
    DB --> UseCase: nuevoIncidente { id: 101, uuid: '550e8400...', created_at }
    deactivate DB

    UseCase -> EventBus: emit('incidente:activado', payload)
    activate EventBus

    par Broadcast en Tiempo Real (WebSockets ≤ 35ms)
        EventBus -> Sockets: retransmitirAlerta(payload)
        activate Sockets
        Sockets -> Guardia: emit('codigo_azul_alerta', { id: 101, cama: 'UCI-01', piso: 3 })
        Sockets -> Reanimador: emit('codigo_azul_alerta', payload)
        deactivate Sockets
    else Push Notification de Alta Prioridad (Doze Mode Bypass)
        EventBus -> FCM: sendEachForMulticast(tokens, high_priority)
        activate FCM
        FCM -> Reanimador: Push Notification con Sirena Sonora
        deactivate FCM
        EventBus -> DB: INSERT auditoria ('NOTIFICACION_PUSH_DESPACHADA')
    end
    deactivate EventBus

    UseCase --> API: { incidente: payloadRespuesta, esReincidencia: false }
    deactivate UseCase
    API --> Activador: HTTP 201 Created { id: 101, codigoUUID: '550e8400...' }
    deactivate API
end

== 2. Respuesta Médica y Confirmación de Asistencia (ACK) ==

Reanimador -> API: PUT /api/v1/incidentes/101/ack\n[Bearer JWT]
activate API

API -> UseCase: ConfirmarAckUseCase.execute({ incidenteId: 101, user })
activate UseCase

UseCase -> DB: findById(101)
activate DB
DB --> UseCase: incidenteData (estado: 'ACTIVADO', created_at: t0)
deactivate DB

UseCase -> UseCase: calcularLatencia(t_actual - t0) = 1.25s

UseCase -> DB: BEGIN TRANSACTION
activate DB
UseCase -> DB: UPDATE incidentes SET estado='EN_ATENCION', reanimador_id=$user.id
UseCase -> DB: INSERT INTO incidentes_auditoria_eventos\n(tipo='ACK_PRIMARIO', latencia: 1.25s, JSONB)
UseCase -> DB: COMMIT
DB --> UseCase: OK
deactivate DB

UseCase -> EventBus: emit('incidente:ack', { id: 101, latencia: 1.25s, reanimador })
activate EventBus
EventBus -> Sockets: retransmitirAck(payload)
activate Sockets
Sockets -> Guardia: emit('codigo_azul_atendido', { id: 101, reanimador: 'Dr. Cardozo' })
deactivate Sockets
deactivate EventBus

UseCase --> API: payloadACK { estado: 'EN_ATENCION', latencia: 1.25s }
deactivate UseCase

API --> Reanimador: HTTP 200 OK (Asistencia Confirmada)
deactivate API

@enduml
