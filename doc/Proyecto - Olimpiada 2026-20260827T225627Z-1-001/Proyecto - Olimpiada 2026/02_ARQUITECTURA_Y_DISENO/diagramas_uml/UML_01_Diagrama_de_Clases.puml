@startuml UML_01_Diagrama_de_Clases
!theme plain
skinparam roundcorner 8
skinparam linetype ortho
skinparam shadowing true
skinparam backgroundColor #FFFFFF
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #0F172A
}
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    HeaderBackgroundColor #1E293B
    FontColor #0F172A
    BorderThickness 1.2
}

header Plataforma Hospitalaria Código Azul — ONETP 2026
title UML-01: Diagrama de Clases y Modelo de Dominio (Clean Architecture)

package "Capa de Dominio (Core)" #EFF6FF {
    enum RolUsuario <<ENUM>> {
        ADMINISTRADOR
        MEDICO_ACTIVADOR
        REANIMADOR_MEDICO
        OPERADOR_GUARDIA
    }

    enum EstadoIncidente <<ENUM>> {
        ACTIVADO
        NOTIFICADO
        EN_ATENCION
        RESUELTO
        CANCELADO
    }

    class Usuario {
        + id: number
        + nombre: string
        + apellido: string
        + email: string
        - passwordHash: string
        + rol: RolUsuario
        + activo: boolean
        + createdAt: Date
        + esAdmin(): boolean
    }

    class Ubicacion {
        + id: number
        + edificio: string
        + piso: number
        + sectorSala: string
        + cama: string
        + createdAt: Date
        + getReferenciaCompleta(): string
    }

    class Incidente {
        + id: number
        + codigoUUID: string
        + ubicacionId: number
        + activadoPorId: number
        + reanimadorId: number
        + estado: EstadoIncidente
        + motivoCancelacion: string
        + createdAt: Date
        + resolvedAt: Date
        + calcularLatencia(tRef: Date): number
        + esActivo(): boolean
    }

    class AuditoriaEvento {
        + id: number
        + incidenteId: number
        + usuarioId: number
        + tipoEvento: string
        + payloadData: JSON
        + timestampEvento: Date
    }

    class DispositivoFCM {
        + id: number
        + usuarioId: number
        + tokenFCM: string
        + plataforma: string
        + activo: boolean
        + ultimoAcceso: Date
    }
}

package "Capa de Aplicación (Use Cases)" #F0FDF4 {
    class ActivarCodigoAzulUseCase {
        - repo: IncidenteRepository
        - auditRepo: AuditoriaRepository
        + execute(params: object): Promise<Result>
    }

    class ConfirmarAckUseCase {
        - repo: IncidenteRepository
        - auditRepo: AuditoriaRepository
        + execute(params: object): Promise<Result>
    }

    class CancelarIncidenteUseCase {
        - repo: IncidenteRepository
        - auditRepo: AuditoriaRepository
        + execute(params: object): Promise<Result>
    }

    class ResolverIncidenteUseCase {
        - repo: IncidenteRepository
        - auditRepo: AuditoriaRepository
        + execute(params: object): Promise<Result>
    }

    class ListarActivosUseCase {
        - repo: IncidenteRepository
        - auditRepo: AuditoriaRepository
        + execute(): Promise<Incidente[]>
        + obtenerDetalle(id: number): Promise<object>
        + listarUbicaciones(): Promise<Ubicacion[]>
    }

    class DespacharPushUseCase {
        - repo: FcmRepository
        + execute(payload: object): Promise<Result>
    }
}

package "Capa de Datos (Repository Pattern)" #FEF3C7 {
    interface IIncidenteRepository {
        + create(data: object, client?: any): Promise<Incidente>
        + findById(id: number, client?: any): Promise<Incidente>
        + findRecentActiveByUbicacion(ubicacionId: number, windowSeconds: number): Promise<Incidente>
        + update(id: number, fields: object, client?: any): Promise<Incidente>
        + findActivos(): Promise<Incidente[]>
        + listarUbicaciones(): Promise<Ubicacion[]>
    }

    interface IAuditoriaRepository {
        + registrar(params: object, client?: any): Promise<AuditoriaEvento>
        + findByIncidenteId(incidenteId: number): Promise<AuditoriaEvento[]>
    }

    interface IFcmRepository {
        + upsertToken(params: object): Promise<DispositivoFCM>
        + obtenerTokensActivosPorRoles(roles: string[]): Promise<DispositivoFCM[]>
        + desactivarToken(token: string): Promise<void>
        + registrarDespachoPush(params: object): Promise<object>
    }
}

package "Capa de Presentación e Infraestructura" #F5F3FF {
    class IncidenteController {
        + activar(req, res): Promise<void>
        + confirmarAck(req, res): Promise<void>
        + cancelar(req, res): Promise<void>
        + resolver(req, res): Promise<void>
        + listarActivos(req, res): Promise<void>
        + listarUbicaciones(req, res): Promise<void>
        + obtenerDetalle(req, res): Promise<void>
    }

    class SocketGateway {
        - io: Server
        + initSocketGateway(httpServer): Server
        + retransmitirAlerta(incidente): void
        + retransmitirAck(incidente): void
        + retransmitirCancelacion(incidente): void
    }

    class AppEventsBus {
        + emit(event: string, payload: object): void
        + on(event: string, handler: function): void
    }
}

' Asociaciones de Dominio
Usuario "1" o-- "0..*" Incidente : activa
Usuario "1" o-- "0..*" Incidente : reanima
Ubicacion "1" *-- "0..*" Incidente : localiza
Incidente "1" *-- "1..*" AuditoriaEvento : audita
Usuario "1" *-- "0..*" DispositivoFCM : vincula
Usuario --> RolUsuario : clasifica
Incidente --> EstadoIncidente : transiciona

' Dependencias de Casos de Uso
ActivarCodigoAzulUseCase ..> IIncidenteRepository : usa
ActivarCodigoAzulUseCase ..> IAuditoriaRepository : usa
ActivarCodigoAzulUseCase ..> AppEventsBus : notifica

ConfirmarAckUseCase ..> IIncidenteRepository : usa
ConfirmarAckUseCase ..> IAuditoriaRepository : usa
ConfirmarAckUseCase ..> AppEventsBus : notifica

CancelarIncidenteUseCase ..> IIncidenteRepository : usa
CancelarIncidenteUseCase ..> IAuditoriaRepository : usa

ResolverIncidenteUseCase ..> IIncidenteRepository : usa
ResolverIncidenteUseCase ..> IAuditoriaRepository : usa

ListarActivosUseCase ..> IIncidenteRepository : usa

DespacharPushUseCase ..> IFcmRepository : usa

' Capa de Presentación
IncidenteController ..> ActivarCodigoAzulUseCase : delega
IncidenteController ..> ConfirmarAckUseCase : delega
IncidenteController ..> CancelarIncidenteUseCase : delega
IncidenteController ..> ResolverIncidenteUseCase : delega
IncidenteController ..> ListarActivosUseCase : delega

AppEventsBus ..> SocketGateway : retransmite
AppEventsBus ..> DespacharPushUseCase : suscribe

@enduml
